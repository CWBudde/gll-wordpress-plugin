{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "gll-info/geometry",
  "version": "0.1.0",
  "title": "GLL Geometry Viewer",
  "category": "media",
  "icon": "admin-site-alt3",
  "description": "Display GLL case geometry in a Three.js viewer.",
  "keywords": [
    "gll",
    "geometry",
    "3d",
    "viewer",
    "three"
  ],
  "attributes": {
    "fileId": {
      "type": "number",
      "default": 0
    },
    "fileUrl": {
      "type": "string",
      "default": ""
    },
    "fileName": {
      "type": "string",
      "default": ""
    },
    "geometryIndex": {
      "type": "number",
      "default": 0
    },
    "showFaces": {
      "type": "boolean",
      "default": true
    },
    "showEdges": {
      "type": "boolean",
      "default": true
    },
    "showMarkers": {
      "type": "object",
      "default": {
        "ref": true,
        "com": true,
        "pivot": false
      }
    },
    "showSources": {
      "type": "boolean",
      "default": false
    },
    "centerReference": {
      "type": "boolean",
      "default": false
    },
    "autoRotate": {
      "type": "boolean",
      "default": false
    },
    "canvasHeight": {
      "type": "number",
      "default": 500
    },
    "appearance": {
      "type": "string",
      "enum": [
        "auto",
        "plain",
        "transparent"
      ],
      "default": "auto"
    }
  },
  "example": {
    "attributes": {
      "fileName": "example-speaker.gll"
    }
  },
  "variations": [
    {
      "name": "wireframe",
      "title": "GLL Wireframe Geometry",
      "description": "Cabinet geometry drawn as edges only, without shaded faces.",
      "icon": "admin-site-alt3",
      "attributes": {
        "showFaces": false
      },
      "scope": [
        "inserter"
      ]
    },
    {
      "name": "turntable",
      "title": "GLL Rotating Geometry",
      "description": "Cabinet geometry that rotates on its own, for use as a display element.",
      "icon": "admin-site-alt3",
      "attributes": {
        "autoRotate": true
      },
      "scope": [
        "inserter"
      ]
    }
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "textdomain": "gll-info",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": [
    "file:./view.js",
    "gll-info-wasm-exec"
  ]
}